<?xml version="1.0" encoding="utf-8"?>
<!-- Shape compleja para tarjetas: gradiente, cornerRadius y shadow color -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:startColor="#F8F9FF"
        android:endColor="#EEF0FF"
        android:angle="135" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="#E0E4FF" />
    <padding android:left="4dp" android:top="4dp"
        android:right="4dp" android:bottom="4dp" />
</shape>
